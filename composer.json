{
    "name": "zvizvi/filament-vue-table",
    "description": "Replace the Livewire-rendered table on a Filament v5 Resource List page with a Vue 3 island, fed by the existing table() schema.",
    "keywords": [
        "filament",
        "laravel",
        "vue",
        "table",
        "filament-plugin"
    ],
    "homepage": "https://github.com/zvizvi/filament-vue-table",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "zvizvi",
            "homepage": "https://github.com/zvizvi"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "~5.6.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Zvizvi\\FilamentVueTable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zvizvi\\FilamentVueTable\\Tests\\": "tests/",
            "Zvizvi\\FilamentVueTable\\Tests\\Fixtures\\Database\\Factories\\": "tests/Fixtures/database/factories/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zvizvi\\FilamentVueTable\\FilamentVueTableServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
